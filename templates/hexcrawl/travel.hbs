<div class="wastelander-hexcrawl-layout{{#unless isOverseer}} wastelander-hexcrawl-player-view{{/unless}}">
  <div class="wastelander-hexcrawl-body">
    {{#if journalReady}}
    <div class="wastelander-hexcrawl-journal-bar">
      <button type="button" class="wastelander-btn-secondary" data-action="openJournal">
        <i class="fas fa-book" aria-hidden="true"></i> {{strings.openJournal}}
      </button>
    </div>
    {{/if}}

    {{#if state.enabled}}
    <div class="wastelander-hexcrawl-status-bar">
      <div class="wastelander-hexcrawl-status-left">
        <span class="wastelander-hexcrawl-badge {{courseStatusClass}}">{{courseStatusLabel}}</span>
        <span class="wastelander-hexcrawl-difficulty-value">{{strings.difficulty}}: {{state.currentDifficulty}}</span>
      </div>
      <div class="wastelander-hexcrawl-status-right">
        <span class="wastelander-hexcrawl-current-terrain">{{strings.terrain}}: {{currentTerrainLabel}}</span>
      </div>
    </div>

    <p class="wastelander-hexcrawl-destination-bar">
      {{strings.destination}}: {{progressDestinationLabel}}
    </p>

    {{#unless isOverseer}}
    <section class="wastelander-hexcrawl-section wastelander-hexcrawl-progress-summary">
      <p>{{strings.travelDay}}: {{state.travelDay}}</p>
      <p>{{strings.currentMph}}: {{partyMph}}{{#if paceActorName}} ({{paceActorName}}){{/if}}</p>
      <p>{{strings.milesTraveled}}: {{milesTraveledLabel}}</p>
      <p>{{strings.hoursToday}}: {{hoursTodayLabel}} / {{state.maxHoursPerDay}}{{#if hoursActorName}} ({{hoursActorName}}){{/if}}</p>
    </section>
    {{/unless}}
    {{/if}}

    {{#if isOverseer}}
    <nav class="wastelander-scavenger-tabs wastelander-hexcrawl-tabs" role="tablist">
      <button type="button" role="tab" class="wastelander-scavenger-tab{{#if tabScene}} is-active{{/if}}" data-action="switchTab" data-tab="scene" aria-selected="{{tabScene}}">
        {{strings.tabScene}}
      </button>
      <button type="button" role="tab" class="wastelander-scavenger-tab{{#if tabParty}} is-active{{/if}}" data-action="switchTab" data-tab="party" aria-selected="{{tabParty}}">
        {{strings.tabParty}}
      </button>
      <button type="button" role="tab" class="wastelander-scavenger-tab{{#if tabMap}} is-active{{/if}}" data-action="switchTab" data-tab="map" aria-selected="{{tabMap}}">
        {{strings.tabMap}}
      </button>
    </nav>
    {{/if}}

    {{#if isOverseer}}
    {{#if tabScene}}
    <div class="wastelander-scavenger-tab-panel wastelander-hexcrawl-tab-panel" role="tabpanel">
      <section class="wastelander-hexcrawl-section wastelander-hexcrawl-enable">
        <label class="wastelander-field-checkbox">
          <input type="checkbox" name="enabled" {{#if state.enabled}}checked{{/if}} data-field="enabled" />
          <span>{{strings.enableLabel}}</span>
        </label>
      </section>

      {{#if state.enabled}}
      <section class="wastelander-hexcrawl-section wastelander-hexcrawl-hex-coords-toggle">
        <label class="wastelander-field-checkbox">
          <input type="checkbox" name="showHexCoords" {{#if state.showHexCoords}}checked{{/if}} data-field="showHexCoords" />
          <span>{{strings.showHexCoords}}</span>
        </label>
      </section>

      <section class="wastelander-hexcrawl-section wastelander-hexcrawl-progress">
        <div class="wastelander-hexcrawl-progress-header">
          <h3>{{strings.progress}}</h3>
        </div>
        <p>{{strings.travelDay}}: {{state.travelDay}}</p>
        <p>{{strings.currentMph}}: {{partyMph}}{{#if paceActorName}} ({{paceActorName}}){{/if}}</p>
        <p>{{strings.milesTraveled}}: {{milesTraveledLabel}}</p>
        <p>{{strings.hoursToday}}: {{hoursTodayLabel}} / {{state.maxHoursPerDay}}{{#if hoursActorName}} ({{hoursActorName}}){{/if}}</p>
        <p>{{strings.startingHex}}: {{startingHexLabel}}</p>
        <p>{{strings.lastHex}}: {{lastHexLabel}}</p>
        {{#if state.arrived}}
          <p class="wastelander-hexcrawl-badge arrived">{{strings.arrived}}</p>
        {{/if}}
        {{#if state.pendingDayEnd}}
          <p class="wastelander-hexcrawl-pending-day-end">{{strings.pendingDayEnd}}</p>
        {{/if}}
        <div class="wastelander-hexcrawl-actions">
          <button type="button" class="wastelander-btn-primary" data-action="coursePass" {{#unless courseChecksEnabled}}disabled{{/unless}}>{{strings.coursePass}}</button>
          <button type="button" class="wastelander-btn-secondary" data-action="courseFail" {{#unless courseFailEnabled}}disabled{{/unless}}>{{strings.courseFail}}</button>
          <button type="button" class="wastelander-btn-secondary" data-action="confirmDayEnd" {{#unless confirmDayEndEnabled}}disabled{{/unless}}>{{strings.confirmDayEnd}}</button>
        </div>
      </section>

      <section class="wastelander-hexcrawl-section">
        <h3>{{strings.travelSettings}}</h3>
        <p class="wastelander-scavenger-hint">{{strings.sceneGridDistance}}: {{sceneGridDistanceLabel}}</p>
        <div class="wastelander-field-row">
          <label>{{strings.travelEvents}}</label>
          <select name="travelEventMode" data-field="travelEventMode">
            {{#each travelEventModeOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="wastelander-field-row">
          <label>{{strings.terrainType}}</label>
          <select name="terrainType" data-field="terrainType">
            {{#each terrainTypeOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <p class="wastelander-scavenger-hint">{{strings.terrainTypeHint}}</p>
        <div class="wastelander-field-row wastelander-hexcrawl-trail-color">
          <label for="hexcrawl-trail-overlay-color">{{strings.trailOverlayColor}}</label>
          <input
            id="hexcrawl-trail-overlay-color"
            type="color"
            name="trailOverlayColor"
            value="{{state.trailOverlayColor}}"
            data-field="trailOverlayColor"
            title="{{strings.trailOverlayColor}}"
          />
        </div>
        <p class="wastelander-scavenger-hint">{{strings.trailOverlayColorHint}}</p>
      </section>

      <section class="wastelander-hexcrawl-section">
        <h3>{{strings.navigation}}</h3>
        <div class="wastelander-field-row">
          <label>{{strings.navigationCondition}}</label>
          <select name="navigationConditionId" data-field="navigationConditionId">
            {{#each navigationOptions}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}} ({{baseDifficulty}})</option>
            {{/each}}
          </select>
        </div>
        <div class="wastelander-hexcrawl-actions">
          <button type="button" class="wastelander-btn-secondary" data-action="markLost" {{#unless markLostEnabled}}disabled{{/unless}}>{{strings.markLost}}</button>
        </div>
      </section>

      <section class="wastelander-hexcrawl-section">
        <h3>{{strings.sceneConnections}}</h3>
        <p class="wastelander-scavenger-hint">{{strings.sceneConnectionsHint}}</p>
        {{#each sceneLinkRows}}
        <div class="wastelander-field-row">
          <label>{{label}}</label>
          <select name="sceneLinks-{{direction}}" data-field="sceneLinks.{{direction}}">
            <option value="">{{../strings.sceneLinkNone}}</option>
            {{#each options}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
            {{/each}}
          </select>
        </div>
        {{/each}}
        <div class="wastelander-hexcrawl-actions">
          <button type="button" class="wastelander-btn-secondary" data-action="exportSceneConfig">{{strings.exportSceneConfig}}</button>
          <button type="button" class="wastelander-btn-secondary" data-action="importSceneConfig">{{strings.importSceneConfig}}</button>
        </div>
      </section>
      {{/if}}
    </div>
    {{/if}}
    {{/if}}

    {{#if showMapPanel}}
    <div class="wastelander-scavenger-tab-panel wastelander-hexcrawl-tab-panel" role="tabpanel">
      {{#if state.enabled}}
      <section class="wastelander-hexcrawl-section wastelander-hexcrawl-map-editor">
        <label class="wastelander-field-checkbox">
          <input type="checkbox" name="showTerrainIcons" {{#if state.showTerrainIcons}}checked{{/if}} data-field="showTerrainIcons" />
          <span>{{strings.mapShowTerrainIcons}}</span>
        </label>
        <p class="wastelander-scavenger-hint">{{strings.mapTabHint}}</p>

        <h3>{{strings.mapSelectedHex}}</h3>
        <p class="wastelander-hexcrawl-map-selected-key">{{#if selectedHexKey}}{{selectedHexKey}}{{else}}—{{/if}}</p>

        <div class="wastelander-hexcrawl-map-editor-fields">
        {{#if selectedHexKey}}
        <p>{{strings.mapEffectiveMph}}: {{selectedHexMph}} ({{selectedHexTerrainLabel}})</p>
        {{/if}}
        <div class="wastelander-field-row">
          <label>{{strings.mapTerrain}}</label>
          <select name="mapHexTerrain" data-field="mapHexTerrain">
            {{#each mapHexTerrainOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="wastelander-hexcrawl-map-trail-actions">
          {{#if mapTrailHidden}}
          <button type="button" class="wastelander-btn-secondary" data-action="showMapTrail">{{strings.mapShowTrail}}</button>
          {{else}}
          <button type="button" class="wastelander-btn-secondary" data-action="hideMapTrail">{{strings.mapHideTrail}}</button>
          {{/if}}
        </div>
        <h4>{{strings.mapHexCover}}</h4>
        <p class="wastelander-scavenger-hint">{{strings.mapHexCoverHint}}</p>
        <div class="wastelander-hexcrawl-hex-cover-controls">
          <button
            type="button"
            class="wastelander-hexcrawl-hex-cover-btn{{#if mapHexCoverActive}} is-selected{{/if}}"
            data-action="toggleMapHexCover"
            title="{{strings.mapHexCover}}"
            aria-pressed="{{#if mapHexCoverActive}}true{{else}}false{{/if}}"
          >
            <span class="wastelander-hexcrawl-hex-cover-preview" style="--hex-cover-color: {{mapHexCoverPreviewColor}}"></span>
            <span>{{strings.mapHexCover}}</span>
          </button>
          <div class="wastelander-field-row wastelander-hexcrawl-hex-cover-color">
            <label for="hexcrawl-map-hex-cover-color">{{strings.mapHexCoverColor}}</label>
            <input
              id="hexcrawl-map-hex-cover-color"
              type="color"
              name="hexCoverBrushColor"
              value="{{mapHexCoverPickerColor}}"
              data-field="hexCoverBrushColor"
              title="{{strings.mapHexCoverColor}}"
            />
          </div>
        </div>
        <h4>{{strings.mapDestination}}</h4>
        <p class="wastelander-scavenger-hint">{{strings.mapDestinationHint}}</p>
        <div class="wastelander-hexcrawl-destination-toolbar">
          <button
            type="button"
            class="wastelander-hexcrawl-destination-btn{{#if mapDestinationOnSelectedHex}} is-selected{{/if}}"
            data-action="setMapDestination"
            title="{{strings.setMapDestination}}"
            aria-pressed="{{#if mapDestinationOnSelectedHex}}true{{else}}false{{/if}}"
          >
            <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
            <span>{{strings.setMapDestination}}</span>
          </button>
          {{#if mapDestinationName}}
          <button type="button" class="wastelander-btn-secondary" data-action="clearMapDestination">
            {{strings.clearMapDestination}}
          </button>
          {{/if}}
        </div>
        {{#if mapDestinationName}}
        <p class="wastelander-scavenger-hint">{{mapDestinationName}} ({{mapDestinationHex}})</p>
        {{/if}}
        <h4>{{strings.mapPoiIcon}}</h4>
        <p class="wastelander-scavenger-hint">{{strings.mapPoiIconHint}}</p>
        <div class="wastelander-hexcrawl-poi-icon-toolbar">
          <button type="button" class="wastelander-btn-secondary" data-action="addMapPoiIcon">
            {{strings.mapAddPoiIcon}}
          </button>
        </div>
        {{#if mapPoiIcons.length}}
        <div class="wastelander-hexcrawl-poi-icon-grid">
          {{#each mapPoiIcons}}
          <div class="wastelander-hexcrawl-poi-icon-cell" data-poi-icon-id="{{id}}">
            <button
              type="button"
              class="wastelander-hexcrawl-poi-icon-remove"
              data-action="removeMapPoiIcon"
              title="{{../strings.mapRemovePoiIcon}}"
            >
              <i class="fas fa-times" aria-hidden="true"></i>
            </button>
            <button
              type="button"
              class="wastelander-hexcrawl-poi-icon-btn{{#if selected}} is-selected{{/if}}"
              data-action="setMapPoiIcon"
              data-icon-id="{{id}}"
              title="{{label}}"
              aria-pressed="{{#if selected}}true{{else}}false{{/if}}"
            >
              <img src="{{imageUrl}}" alt="{{label}}" width="56" height="56" />
              <span>{{label}}</span>
            </button>
          </div>
          {{/each}}
        </div>
        {{else}}
        <p class="wastelander-scavenger-hint">{{strings.mapNoPoiIcons}}</p>
        {{/if}}
        <div class="wastelander-hexcrawl-actions">
          <button type="button" class="wastelander-btn-secondary" data-action="clearMapHex">{{strings.mapClearHex}}</button>
        </div>
        </div>
      </section>
      {{else}}
      <p class="wastelander-scavenger-hint">{{strings.enableLabel}}</p>
      {{/if}}
    </div>
    {{/if}}

    {{#if showPartyPanel}}
    <div class="wastelander-scavenger-tab-panel wastelander-hexcrawl-tab-panel" role="tabpanel">
      {{#if state.enabled}}
      <section class="wastelander-hexcrawl-section">
        <div class="wastelander-hexcrawl-party-dropzone" data-hexcrawl-party-drop>
          {{#if partyRows.length}}
          <ul class="wastelander-hexcrawl-party-list">
            {{#each partyRows}}
            <li class="wastelander-hexcrawl-party-member">
              <span class="wastelander-hexcrawl-party-member-name">{{actorName}}</span>
              <span class="wastelander-hexcrawl-party-roles">
                {{#if isNavigator}}<span class="wastelander-hexcrawl-badge role-navigator">{{../strings.roleNavigator}}</span>{{/if}}
                {{#if isPace}}<span class="wastelander-hexcrawl-badge role-pace">{{../strings.rolePace}}</span>{{/if}}
                {{#if setsMaxHours}}<span class="wastelander-hexcrawl-badge role-hours">{{../strings.roleMaxHours}}</span>{{/if}}
              </span>
              {{#if canRemove}}
              <button type="button" class="wastelander-hexcrawl-party-remove" data-action="removePartyMember" data-actor-id="{{actorId}}" title="{{../strings.removeMember}}" aria-label="{{../strings.removeMember}}">
                <i class="fas fa-times" aria-hidden="true"></i>
              </button>
              {{/if}}
            </li>
            {{/each}}
          </ul>
          <p class="wastelander-scavenger-hint wastelander-hexcrawl-party-drop-hint">{{strings.partyDropHint}}</p>
          {{else}}
          <p class="wastelander-hexcrawl-party-drop-empty">{{strings.partyDropHint}}</p>
          {{/if}}
        </div>
      </section>
      {{/if}}
    </div>
    {{/if}}
  </div>

  {{#if isOverseer}}
  {{#if state.enabled}}
  {{#if tabScene}}
  <div class="wastelander-hexcrawl-scene-bar">
    <button type="button" class="wastelander-btn-secondary" data-action="clearJournal" {{#unless journalHasEntries}}disabled{{/unless}}>{{strings.clearJournal}}</button>
  </div>
  {{/if}}
  <footer class="wastelander-hexcrawl-footer">
    <button type="button" class="wastelander-btn-secondary" data-action="setStartingLocation">{{strings.setStartingLocation}}</button>
    <button type="button" class="wastelander-btn-secondary" data-action="resetMap">{{strings.resetMap}}</button>
    {{#if state.arrived}}
      <button type="button" class="wastelander-btn-primary" data-action="resumeTravel">{{strings.resumeTravel}}</button>
    {{else}}
      <button type="button" class="wastelander-btn-primary" data-action="markArrival">{{strings.markArrival}}</button>
    {{/if}}
    <button type="button" class="wastelander-btn-secondary" data-action="resetTravel">{{strings.resetTravel}}</button>
  </footer>
  {{/if}}
  {{/if}}
</div>
