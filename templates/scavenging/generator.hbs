<div class="wastelander-scavenger-layout">
  <div class="wastelander-scavenger-scroll">
  <header class="wastelander-scavenger-header">
    <h1>{{localize "WASTELANDER.Scavenging.Title"}}</h1>
    <p class="wastelander-scavenger-hint">{{localize "WASTELANDER.Scavenging.Hint"}}</p>
    {{#if sceneScope}}
      <p class="wastelander-scavenger-scene-scope">{{sceneScope}}</p>
    {{/if}}
  </header>

  <nav class="wastelander-scavenger-tabs" role="tablist">
    <button type="button" role="tab" class="wastelander-scavenger-tab{{#if tabCurrent}} is-active{{/if}}" data-action="switchTab" data-tab="current" aria-selected="{{tabCurrent}}">
      {{localize "WASTELANDER.Scavenging.Tabs.Current"}}
    </button>
    <button type="button" role="tab" class="wastelander-scavenger-tab{{#if tabCreate}} is-active{{/if}}" data-action="switchTab" data-tab="create" aria-selected="{{tabCreate}}">
      {{localize "WASTELANDER.Scavenging.Tabs.Create"}}
    </button>
  </nav>

  {{#if tabCurrent}}
  <div class="wastelander-scavenger-tab-panel" role="tabpanel">
    {{#if current.empty}}
      <p class="wastelander-scavenger-hint">{{localize "WASTELANDER.Scavenging.Current.Empty"}}</p>
      <button type="button" data-action="switchTab" data-tab="create" class="wastelander-btn-secondary">
        {{localize "WASTELANDER.Scavenging.Current.GoCreate"}}
      </button>
    {{else}}
      <section class="wastelander-scavenger-section">
        <h2>{{current.name}}</h2>
        {{#if current.concept}}
          <p class="wastelander-scavenger-hint">{{current.concept}}</p>
        {{/if}}
        <dl class="wastelander-scavenger-location-meta">
          <div><dt>{{localize "WASTELANDER.Scavenging.Fields.Scale"}}</dt><dd>{{current.scaleLabel}}</dd></div>
          <div><dt>{{localize "WASTELANDER.Scavenging.Fields.Category"}}</dt><dd>{{current.categoryLabel}}</dd></div>
          <div><dt>{{localize "WASTELANDER.Scavenging.Fields.Degree"}}</dt><dd>{{current.degreeLabel}}</dd></div>
        </dl>
      </section>

      <section class="wastelander-scavenger-section wastelander-scavenger-generated-stats">
        <div class="wastelander-scavenger-stat">
          <span class="wastelander-scavenger-stat-label">{{localize "WASTELANDER.Scavenging.Fields.Level"}}</span>
          <output class="wastelander-scavenger-stat-value">{{current.generated.level}}</output>
        </div>
        <div class="wastelander-scavenger-stat">
          <span class="wastelander-scavenger-stat-label">{{localize "WASTELANDER.Scavenging.Generated.SearchDifficulty"}}</span>
          <output class="wastelander-scavenger-stat-value">{{current.generated.searchDifficulty}}</output>
        </div>
        <div class="wastelander-scavenger-stat">
          <span class="wastelander-scavenger-stat-label">{{localize "WASTELANDER.Scavenging.Generated.TimeTaken"}}</span>
          <output class="wastelander-scavenger-stat-value">{{current.generated.searchMinutes}} {{localize "WASTELANDER.Scavenging.Generated.Minutes"}} <span class="wastelander-scavenger-stat-sub">({{current.generated.searchTimeLabel}})</span></output>
        </div>
      </section>

      <section class="wastelander-scavenger-section wastelander-scavenger-panel">
        <h2>{{localize "WASTELANDER.Scavenging.Current.Inhabitants"}}</h2>
        {{#if current.inhabitants}}
          {{#if current.inhabitants.countSummary}}
            <p class="wastelander-scavenger-inhabitant-count">{{current.inhabitants.countSummary}}</p>
            <p class="wastelander-scavenger-hint">{{current.inhabitants.typeLabel}}</p>
          {{/if}}
          {{#if current.inhabitants.overseerOverride}}
            <p class="wastelander-scavenger-hint">{{localize "WASTELANDER.Scavenging.Inhabitants.OverseerOverrideNote"}}</p>
          {{else if current.inhabitants.rosterEmpty}}
            <p class="wastelander-scavenger-warning">{{localize "WASTELANDER.Scavenging.Inhabitants.RosterEmpty"}}</p>
          {{else}}
            <ul class="wastelander-scavenger-inhabitant-roster">
              {{#each current.inhabitants.roster}}
                <li class="wastelander-scavenger-inhabitant-row">
                  {{#if actorUuid}}
                    <span class="wastelander-inhabitant-drag" data-inhabitant-drag data-actor-uuid="{{actorUuid}}" draggable="true" title="{{localize "WASTELANDER.Scavenging.Inhabitants.DragHint"}}">
                      <button type="button" class="wastelander-scavenger-table-link" data-action="openInhabitantActor" data-actor-uuid="{{actorUuid}}">
                        <i class="fas fa-user" aria-hidden="true"></i> {{name}}
                      </button>
                      <span class="wastelander-scavenger-inhabitant-meta">({{localize "WASTELANDER.Scavenging.Inhabitants.LevelShort"}} {{level}}){{#if sizeLabel}} — {{sizeLabel}}{{/if}}</span>
                    </span>
                  {{else}}
                    {{name}}
                    <span class="wastelander-scavenger-inhabitant-meta">({{localize "WASTELANDER.Scavenging.Inhabitants.LevelShort"}} {{level}}){{#if sizeLabel}} — {{sizeLabel}}{{/if}}</span>
                  {{/if}}
                </li>
              {{/each}}
            </ul>
          {{/if}}
        {{else}}
          <p class="wastelander-scavenger-hint">{{localize "WASTELANDER.Scavenging.Current.None"}}</p>
        {{/if}}
      </section>

      <section class="wastelander-scavenger-section wastelander-scavenger-panel">
        <h2>{{localize "WASTELANDER.Scavenging.Current.Hazards"}}</h2>
        {{#if current.hazard.present}}
          <p class="wastelander-scavenger-inhabitant-count">{{current.hazard.kindLabel}}</p>
          <p class="wastelander-scavenger-hint">{{{current.hazard.summary}}}</p>
          {{#if current.hazard.damageUi.show}}
            <div class="wastelander-scavenger-hazard-damage">
              <p class="wastelander-scavenger-hint wastelander-scavenger-hazard-damage-formula">
                {{{current.hazard.damageUi.formulaHintHtml}}}
                <span class="wastelander-scavenger-hazard-damage-time">({{current.hazard.damageUi.searchTimeLabel}})</span>
              </p>
              <h3 class="wastelander-scavenger-subheading">{{localize "WASTELANDER.Scavenging.HazardDamage.PartyTitle"}}</h3>
              {{#if current.hazard.damageUi.partyEmpty}}
                <p class="wastelander-scavenger-hint">{{localize "WASTELANDER.Scavenging.HazardDamage.PartyEmpty"}}</p>
              {{else}}
                <ul class="wastelander-scavenger-hazard-damage-party">
                  {{#each current.hazard.damageUi.players}}
                    <li>
                      <span class="wastelander-scavenger-hazard-damage-name">{{actorName}}</span>
                      <span class="wastelander-scavenger-hazard-damage-user">{{userName}}</span>
                      <button
                        type="button"
                        class="wastelander-btn-secondary wastelander-scavenger-hazard-damage-btn"
                        data-action="applyHazardDamage"
                        data-actor-id="{{actorId}}"
                      >
                        {{localize "WASTELANDER.Scavenging.HazardDamage.Apply"}}
                      </button>
                    </li>
                  {{/each}}
                </ul>
              {{/if}}
            </div>
          {{/if}}
        {{else}}
          <p class="wastelander-scavenger-hint">{{localize "WASTELANDER.Scavenging.Current.None"}}</p>
        {{/if}}
      </section>

      <section class="wastelander-scavenger-section">
        <h2>{{localize "WASTELANDER.Scavenging.Current.Obstacles"}}</h2>
        {{#if current.obstacle.present}}
          <p>{{current.obstacle.summary}}</p>
          {{#if current.obstacle.showOvercome}}
            <label class="wastelander-scavenger-checks">
              <input type="checkbox" data-action="toggleObstacleOvercome" {{#if current.obstacle.overcome}}checked{{/if}} />
              {{localize "WASTELANDER.Scavenging.Current.ObstacleOvercome"}}
            </label>
          {{/if}}
        {{else}}
          <p class="wastelander-scavenger-hint">{{localize "WASTELANDER.Scavenging.Current.None"}}</p>
        {{/if}}
      </section>

      <section class="wastelander-scavenger-section">
        <h2>{{localize "WASTELANDER.Scavenging.Tables.Title"}}</h2>
        <p class="wastelander-scavenger-hint">{{rollTables.sidebarHint}}</p>
        {{#if rollTables.allInstalled}}
          <p class="wastelander-scavenger-ok">{{localize "WASTELANDER.Scavenging.Tables.AllInstalled"}}</p>
        {{else}}
          <p class="wastelander-scavenger-warning">{{localize "WASTELANDER.Scavenging.Tables.Missing"}}</p>
        {{/if}}
        <div class="wastelander-scavenger-loot-grid" role="table">
          <div class="wastelander-scavenger-loot-grid-header" role="row">
            <span role="columnheader">{{localize "WASTELANDER.Scavenging.Tables.ColumnTable"}}</span>
            <span role="columnheader">{{localize "WASTELANDER.Scavenging.Tables.ColumnMin"}}</span>
            <span role="columnheader">{{localize "WASTELANDER.Scavenging.Tables.ColumnMax"}}</span>
          </div>
          {{#each rollTables.rows}}
            <div class="wastelander-scavenger-loot-grid-row" role="row">
              <span class="wastelander-scavenger-loot-name" role="cell">
                {{#if installed}}
                  <button type="button" class="wastelander-scavenger-table-link" data-action="openRollTable" data-table-id="{{tableId}}">
                    <i class="fas fa-dice" aria-hidden="true"></i> {{label}}
                  </button>
                {{else}}
                  {{label}}
                {{/if}}
              </span>
              <span class="wastelander-scavenger-loot-min" role="cell">{{min}}</span>
              <span class="wastelander-scavenger-loot-max" role="cell">{{max}}</span>
            </div>
          {{/each}}
        </div>
      </section>
    {{/if}}
  </div>
  {{/if}}

  {{#if tabCreate}}
  <div class="wastelander-scavenger-tab-panel" role="tabpanel">
  <section class="wastelander-scavenger-section">
    <h2>{{localize "WASTELANDER.Scavenging.Party.Title"}}</h2>
    {{#if partyEmpty}}
      <p class="wastelander-scavenger-warning">{{localize "WASTELANDER.Scavenging.Party.Empty"}}</p>
    {{else}}
      <ul class="wastelander-scavenger-party-list">
        {{#each party}}
          <li>
            <label>
              <input type="checkbox" name="party" data-action="toggleParty" data-actor-id="{{actorId}}" {{#if selected}}checked{{/if}} />
              <span class="wastelander-scavenger-party-user">{{userName}}{{#unless userActive}} <em class="wastelander-scavenger-offline">(offline)</em>{{/unless}}</span>
              <span class="wastelander-scavenger-party-actor">{{actorName}} (Lv {{level}})</span>
            </label>
          </li>
        {{/each}}
      </ul>
    {{/if}}
    <button type="button" data-action="refreshParty" class="wastelander-btn-secondary">
      <i class="fas fa-sync" aria-hidden="true"></i> {{localize "WASTELANDER.Scavenging.Party.Refresh"}}
    </button>
  </section>

  <section class="wastelander-scavenger-section wastelander-scavenger-grid">
    <div class="wastelander-scavenger-field">
      <label for="loc-name">{{localize "WASTELANDER.Scavenging.Fields.Name"}}</label>
      <input id="loc-name" type="text" name="name" value="{{name}}" data-action="updateField" data-field="name" />
    </div>
    <div class="wastelander-scavenger-field">
      <label for="loc-concept">{{localize "WASTELANDER.Scavenging.Fields.Concept"}}</label>
      <input id="loc-concept" type="text" name="concept" value="{{concept}}" data-action="updateField" data-field="concept" />
    </div>
    <div class="wastelander-scavenger-field">
      <label for="loc-scale">{{localize "WASTELANDER.Scavenging.Fields.Scale"}}</label>
      <select id="loc-scale" data-action="updateField" data-field="scale">
        {{#each scaleOptions}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="wastelander-scavenger-field">
      <label for="loc-category">{{localize "WASTELANDER.Scavenging.Fields.Category"}}</label>
      <select id="loc-category" data-action="updateField" data-field="categoryId">
        {{#each categoryOptions}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="wastelander-scavenger-field">
      <label for="loc-degree">{{localize "WASTELANDER.Scavenging.Fields.Degree"}}</label>
      <select id="loc-degree" data-action="updateField" data-field="degree">
        {{#each degreeOptions}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
  </section>

  <section class="wastelander-scavenger-section wastelander-scavenger-generated-stats">
    <div class="wastelander-scavenger-stat">
      <span class="wastelander-scavenger-stat-label">{{localize "WASTELANDER.Scavenging.Fields.Level"}}</span>
      <output class="wastelander-scavenger-stat-value" id="loc-level">{{generated.level}}</output>
    </div>
    <div class="wastelander-scavenger-stat">
      <span class="wastelander-scavenger-stat-label">{{localize "WASTELANDER.Scavenging.Generated.SearchDifficulty"}}</span>
      <output class="wastelander-scavenger-stat-value" id="loc-search-diff">{{generated.searchDifficulty}}</output>
    </div>
    <div class="wastelander-scavenger-stat">
      <span class="wastelander-scavenger-stat-label">{{localize "WASTELANDER.Scavenging.Generated.TimeTaken"}}</span>
      <output class="wastelander-scavenger-stat-value" id="loc-search-time">{{generated.searchMinutes}} {{localize "WASTELANDER.Scavenging.Generated.Minutes"}} <span class="wastelander-scavenger-stat-sub">({{generated.searchTimeLabel}})</span></output>
    </div>
  </section>

  <section class="wastelander-scavenger-section">
    <h2>{{localize "WASTELANDER.Scavenging.Problems.Title"}}</h2>
    <div class="wastelander-scavenger-checks">
      <label><input type="checkbox" data-action="toggleProblem" data-problem="obstacle" {{#if problems.obstacle}}checked{{/if}} /> {{localize "WASTELANDER.Scavenging.Problems.Obstacle"}}</label>
      <label><input type="checkbox" data-action="toggleProblem" data-problem="hazard" {{#if problems.hazard}}checked{{/if}} /> {{localize "WASTELANDER.Scavenging.Problems.Hazard"}}</label>
      <label>
        <input type="checkbox" data-action="toggleProblem" data-problem="inhabitants" {{#if problems.inhabitants}}checked{{/if}} {{#if inhabitantsUi.checkboxDisabled}}disabled{{/if}} />
        {{localize "WASTELANDER.Scavenging.Problems.Inhabitants"}}
      </label>
    </div>
    {{#if problemsUi.showObstacleFields}}
      <fieldset class="wastelander-scavenger-problem-box wastelander-scavenger-obstacle-box">
        <legend>{{localize "WASTELANDER.Scavenging.Problems.Obstacle"}}</legend>
        <div class="wastelander-scavenger-field">
          <label for="loc-obstacle-type">{{localize "WASTELANDER.Scavenging.Problems.ObstacleTypeLabel"}}</label>
          <select id="loc-obstacle-type" data-action="updateField" data-field="obstacleType">
            {{#each problemsUi.obstacleTypeOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        {{#if problemsUi.obstacleSummary}}
          <p class="wastelander-scavenger-hint wastelander-scavenger-problem-box-summary">{{problemsUi.obstacleSummary}}</p>
        {{else}}
          <p class="wastelander-scavenger-hint wastelander-scavenger-problem-box-summary">{{problemsUi.configureHint}}</p>
        {{/if}}
      </fieldset>
    {{/if}}
    {{#if problemsUi.showHazardFields}}
      <fieldset class="wastelander-scavenger-problem-box wastelander-scavenger-hazard-box">
        <legend>{{localize "WASTELANDER.Scavenging.Problems.HazardKindLabel"}}</legend>
        <label>
          <input type="radio" name="hazardKind" value="ongoing" data-action="updateField" data-field="hazardKind" {{#if problemsUi.hazardKindOngoing}}checked{{/if}} />
          {{localize "WASTELANDER.Scavenging.Problems.HazardKinds.ongoing"}}
        </label>
        <label>
          <input type="radio" name="hazardKind" value="occasional" data-action="updateField" data-field="hazardKind" {{#if problemsUi.hazardKindOccasional}}checked{{/if}} />
          {{localize "WASTELANDER.Scavenging.Problems.HazardKinds.occasional"}}
        </label>
        {{#if problemsUi.hazardSummary}}
          <p class="wastelander-scavenger-hint wastelander-scavenger-problem-box-summary">{{{problemsUi.hazardSummary}}}</p>
        {{/if}}
      </fieldset>
    {{/if}}
    {{#unless inhabitantsUi.allowed}}
      <p class="wastelander-scavenger-hint">{{localize "WASTELANDER.Scavenging.Inhabitants.TinyNoInhabitants"}}</p>
    {{/unless}}
    <div class="wastelander-scavenger-field wastelander-scavenger-inhabitant-type">
      <label for="loc-inhabitant-type">{{localize "WASTELANDER.Scavenging.Inhabitants.TypeLabel"}}</label>
      <select id="loc-inhabitant-type" data-action="updateField" data-field="inhabitantType" {{#if inhabitantsUi.typeSelectDisabled}}disabled{{/if}}>
        {{#each inhabitantsUi.typeOptions}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    {{#if inhabitantsUi.showCount}}
      <div class="wastelander-scavenger-inhabitant-summary">
        {{#if inhabitantsUi.countSummary}}
          <p class="wastelander-scavenger-inhabitant-count">{{inhabitantsUi.countSummary}}</p>
        {{/if}}
        {{#if inhabitantsUi.overseerOverride}}
          <p class="wastelander-scavenger-hint">{{localize "WASTELANDER.Scavenging.Inhabitants.OverseerOverrideNote"}}</p>
        {{else if inhabitantsUi.showRoster}}
        {{#if inhabitantsUi.rosterEmpty}}
          <p class="wastelander-scavenger-warning">{{localize "WASTELANDER.Scavenging.Inhabitants.RosterEmpty"}}</p>
        {{else}}
          <ul class="wastelander-scavenger-inhabitant-roster">
            {{#each inhabitantsUi.roster}}
              <li>
                {{#if actorUuid}}
                  <button type="button" class="wastelander-scavenger-table-link" data-action="openInhabitantActor" data-actor-uuid="{{actorUuid}}">
                    <i class="fas fa-user" aria-hidden="true"></i> {{name}}
                  </button>
                {{else}}
                  {{name}}
                {{/if}}
                ({{localize "WASTELANDER.Scavenging.Inhabitants.LevelShort"}} {{level}}){{#if sizeLabel}} — {{sizeLabel}}{{/if}}
              </li>
            {{/each}}
          </ul>
        {{/if}}
        {{/if}}
      </div>
    {{/if}}
  </section>

  <section class="wastelander-scavenger-section">
    <h2>{{localize "WASTELANDER.Scavenging.Tables.Title"}}</h2>
    <p class="wastelander-scavenger-hint">{{rollTables.sidebarHint}}</p>
    {{#unless rollTables.showMinMax}}
      <p class="wastelander-scavenger-hint">{{localize "WASTELANDER.Scavenging.Tables.GenerateForRanges"}}</p>
    {{/unless}}
    {{#if rollTables.showMinMax}}
      {{#if rollTables.allInstalled}}
        <p class="wastelander-scavenger-ok">{{localize "WASTELANDER.Scavenging.Tables.AllInstalled"}}</p>
      {{else}}
        <p class="wastelander-scavenger-warning">{{localize "WASTELANDER.Scavenging.Tables.Missing"}}</p>
      {{/if}}
    {{/if}}
    {{#if otherFound.length}}
      <h3 class="wastelander-scavenger-other-found-title">{{localize "WASTELANDER.Scavenging.Tables.OtherFoundTitle"}}</h3>
      <ul class="wastelander-scavenger-other-found">
        {{#each otherFound}}
          <li><span class="wastelander-scavenger-other-d20">d20 {{d20}}</span> → {{label}}</li>
        {{/each}}
      </ul>
    {{/if}}
    <div class="wastelander-scavenger-loot-grid" role="table">
      <div class="wastelander-scavenger-loot-grid-header" role="row">
        <span role="columnheader">{{localize "WASTELANDER.Scavenging.Tables.ColumnTable"}}</span>
        <span role="columnheader">{{localize "WASTELANDER.Scavenging.Tables.ColumnMin"}}</span>
        <span role="columnheader">{{localize "WASTELANDER.Scavenging.Tables.ColumnMax"}}</span>
      </div>
      {{#each rollTables.rows}}
        <div class="wastelander-scavenger-loot-grid-row" role="row">
          <span class="wastelander-scavenger-loot-name" role="cell">
            {{#if installed}}
              <button type="button" class="wastelander-scavenger-table-link" data-action="openRollTable" data-table-id="{{tableId}}">
                <i class="fas fa-dice" aria-hidden="true"></i> {{label}}
              </button>
            {{else}}
              {{label}}
            {{/if}}
          </span>
          <span class="wastelander-scavenger-loot-min" role="cell">{{min}}</span>
          <span class="wastelander-scavenger-loot-max" role="cell">{{max}}</span>
        </div>
      {{/each}}
    </div>
    <p class="wastelander-scavenger-reduction-formula">{{rollTables.reduction.formulaLine}}</p>
    <p class="wastelander-scavenger-hint wastelander-scavenger-reduction-hint">{{rollTables.reduction.hint}}</p>
  </section>
  </div>
  {{/if}}
  </div>

  <footer class="wastelander-scavenger-actions{{#if tabCreate}} is-create-tab{{/if}}">
    <div class="wastelander-scavenger-actions-group">
      {{#if location}}
        <button type="button" data-action="resetPlayerSearch" class="wastelander-btn-secondary" title="{{localize "WASTELANDER.Scavenging.PlayerSearch.GmResetHint"}}">{{localize "WASTELANDER.Scavenging.PlayerSearch.GmResetSearch"}}</button>
      {{/if}}
      {{#if tabCurrent}}
        {{#if location}}
          <button type="button" data-action="markSearchSuccess" class="wastelander-btn-secondary">{{localize "WASTELANDER.Scavenging.PlayerSearch.GmMarkSuccess"}}</button>
          <button type="button" data-action="markSearchFail" class="wastelander-btn-secondary">{{localize "WASTELANDER.Scavenging.PlayerSearch.GmMarkFail"}}</button>
        {{/if}}
      {{/if}}
    </div>
    {{#if tabCreate}}
      <button type="button" data-action="generate" class="wastelander-btn-primary wastelander-scavenger-actions-generate" {{#if generating}}disabled{{/if}}>{{localize "WASTELANDER.Scavenging.Actions.Generate"}}</button>
    {{/if}}
  </footer>
</div>
