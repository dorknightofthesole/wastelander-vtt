{
  "name": "wastelander",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "prepare": "npm run build",
    "list-pdf-fields": "node scripts/list-pdf-fields.mjs",
    "build:denizens": "node --experimental-strip-types scripts/build-denizens-catalog.mjs",
    "build:oracle": "node scripts/build-oracle-rolltables.mjs",
    "build:oracle:list": "node scripts/build-oracle-rolltables.mjs --list",
    "extract:oracle": "node scripts/extract-oracle-manifests.mjs",
    "extract:oracle:list": "node scripts/extract-oracle-manifests.mjs --list",
    "extract:oracle:dump": "node scripts/extract-oracle-manifests.mjs --dump-pages",
    "build:encounters": "node scripts/build-encounter-rolltables.mjs",
    "build:encounters:list": "node scripts/build-encounter-rolltables.mjs --list",
    "extract:encounters": "node scripts/extract-encounter-manifests.mjs",
    "extract:encounters:list": "node scripts/extract-encounter-manifests.mjs --list",
    "relink:scavenging-tables": "node scripts/relink-scavenging-rolltables.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "pdfjs-dist": "^6.0.227",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
